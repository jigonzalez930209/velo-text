---
/**
 * Astro island — client only. Do not hydrate the AST on the server.
 * Static HTML: import { renderDocumentToHtml } from "velo-text" in a server component.
 */
import PortableEditor from "../react/PortableEditor.jsx";
---
<div data-pde-theme="light-neutral">
  <PortableEditor
    client:load
    document={Astro.props.document}
    theme={Astro.props.theme ?? "light-neutral"}
    editable={Astro.props.editable ?? true}
    onChange={Astro.props.onChange}
  />
</div>
